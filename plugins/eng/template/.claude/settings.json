{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "claude-code-base": {
      "source": {
        "source": "github",
        "repo": "ErickZarat/claude-code-base"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "cursor-plugins": {
      "source": {
        "source": "github",
        "repo": "cursor/plugins"
      }
    }
  },
  "enabledPlugins": {
    "eng@claude-code-base": true,
    "security-guidance@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "pstack@cursor-plugins": true
  },
  "permissions": {
    "ask": [
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "Bash(git branch -D *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.production)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git reset --hard)",
      "Bash(git clean -fd *)",
      "Bash(git clean -fdx *)",
      "Bash(sudo *)",
      "Bash(printenv)",
      "Bash(printenv *)"
    ]
  }
}
